# Copy to .env (never commit .env). pipeline.py loads it automatically; real environment
# variables take precedence.

# Stage A - story generation with Claude (only needed for: pipeline.py --idea "...")
ANTHROPIC_API_KEY=

# Stage B - ElevenLabs narration. Without a key the pipeline uses the offline espeak-ng
# placeholder voice (robotic, for testing only).
ELEVENLABS_API_KEY=
# Optional: a voice id from your ElevenLabs voice library (default: first premade voice)
ELEVENLABS_VOICE_ID=

# Optional rendering overrides
# CHROMIUM_PATH=/path/to/chrome
# CHROMIUM_ARGS=--use-gl=angle --use-angle=vulkan
