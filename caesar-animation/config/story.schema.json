{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caesar-animation.local/story.schema.json",
  "title": "Stickman story",
  "description": "Structured story consumed by the animation engine. Times are seconds relative to the scene start unless an event is anchored to a spoken word with at_word. Coordinates are metres: x = screen right, y = up, z = toward the default camera; ground is y = 0; keep the action inside x -3..3, z -1..1.5.",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "hook", "seed", "cast", "scenes"],
  "properties": {
    "title": { "type": "string", "minLength": 3, "description": "Video title" },
    "hook": { "type": "string", "minLength": 3, "description": "Opening hook line; must also be spoken in the first scene's narration" },
    "logline": { "type": "string" },
    "seed": { "type": "integer", "description": "Seed for deterministic procedural details" },
    "music": { "type": "string", "description": "Optional path to a background music file you are licensed to use" },
    "cast": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "template"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "name": { "type": "string" },
          "template": { "type": "string", "enum": ["hero", "sleepy", "buddy", "boss", "villain", "kid", "friend", "nerd"] }
        }
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scene" }
    }
  },
  "$defs": {
    "vec3": {
      "type": "array",
      "items": { "type": "number" },
      "minItems": 3,
      "maxItems": 3
    },
    "expression": { "type": "string", "enum": ["neutral", "happy", "sad", "surprised", "angry", "scared", "thinking", "smug", "dizzy", "sleepy"] },
    "action_name": {
      "type": "string",
      "enum": ["idle", "talk", "walk", "run", "jump", "fall", "get_up", "sleep", "sit", "stand_up", "look_around", "look_down", "point", "wave", "celebrate", "shock", "sad", "angry", "arms_crossed", "facepalm", "shrug", "think", "laugh", "use_phone"]
    },
    "shot": { "type": "string", "enum": ["extreme_wide", "wide", "full", "medium", "close", "extreme_close"] },
    "angle": { "type": "string", "enum": ["front", "low", "high", "left", "right", "dutch"] },
    "move": {
      "type": "string",
      "enum": ["static", "track", "dolly_in", "dolly_out", "push_in", "zoom_in", "zoom_out", "pan_left", "pan_right", "truck_left", "truck_right", "tilt_up", "tilt_down", "crane_up", "crane_down", "orbit_left", "orbit_right", "handheld"]
    },
    "prop_type": {
      "type": "string",
      "enum": ["bed", "desk", "table", "chair", "office_chair", "couch", "lamp", "desk_lamp", "laptop", "monitor", "tv", "plant", "bookshelf", "window", "poster", "rug", "alarm_clock", "coffee_cup", "whiteboard", "water_cooler", "door", "tree", "rock", "bench", "car", "bus", "streetlight", "trash_can", "sign", "fence", "building", "cloud", "box", "bus_stop"]
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scene_id", "duration", "narration", "visual_description", "characters", "environment", "props", "actions", "camera", "lighting", "sound_effects", "transition"],
      "properties": {
        "scene_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "duration": { "type": "number", "minimum": 1, "maximum": 15, "description": "Planned seconds; stretched automatically if the narration audio is longer" },
        "narration": { "type": "string", "minLength": 1 },
        "visual_description": { "type": "string", "description": "What the viewer sees, including the visual joke" },
        "characters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "position"],
            "properties": {
              "id": { "type": "string" },
              "position": { "$ref": "#/$defs/vec3" },
              "facing": { "type": "string", "enum": ["left", "right", "camera"] },
              "expression": { "$ref": "#/$defs/expression" },
              "action": { "$ref": "#/$defs/action_name", "description": "State the character is already in when the scene opens (e.g. sleep, sit)" }
            }
          }
        },
        "environment": { "type": "string", "enum": ["city", "bedroom", "office", "street", "outdoor"] },
        "props": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "position"],
            "properties": {
              "type": { "$ref": "#/$defs/prop_type" },
              "position": { "$ref": "#/$defs/vec3" },
              "rotation_y": { "type": "number", "description": "Radians" },
              "scale": { "type": "number", "minimum": 0.1, "maximum": 5 },
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
              "motion": {
                "type": "object",
                "additionalProperties": false,
                "required": ["time", "duration", "to"],
                "properties": {
                  "time": { "type": "number", "minimum": 0 },
                  "at_word": { "type": "string" },
                  "duration": { "type": "number", "minimum": 0.05 },
                  "to": { "$ref": "#/$defs/vec3" },
                  "ease": { "type": "string", "enum": ["linear", "easeInQuad", "easeOutQuad", "easeInOutQuad", "easeInOutCubic", "easeOutBack"] }
                }
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["time", "character", "action", "duration"],
            "properties": {
              "time": { "type": "number", "minimum": 0 },
              "at_word": { "type": "string", "description": "Start exactly when this narration word is spoken (overrides time when found)" },
              "character": { "type": "string" },
              "action": { "$ref": "#/$defs/action_name" },
              "duration": { "type": "number", "minimum": 0.1, "maximum": 15 },
              "target": { "$ref": "#/$defs/vec3", "description": "Destination for walk/run/jump/fall, or point/look target" },
              "expression": { "$ref": "#/$defs/expression" },
              "facing": { "type": "string", "enum": ["left", "right", "camera"] },
              "intensity": { "type": "number", "minimum": 0.2, "maximum": 2 }
            }
          }
        },
        "camera": {
          "type": "object",
          "additionalProperties": false,
          "required": ["shot", "target", "move"],
          "properties": {
            "shot": { "$ref": "#/$defs/shot" },
            "target": { "type": "string", "description": "Cast id to frame, or 'group' for all characters in the scene" },
            "move": { "$ref": "#/$defs/move" },
            "angle": { "$ref": "#/$defs/angle" },
            "cuts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["time", "shot", "move"],
                "properties": {
                  "time": { "type": "number", "minimum": 0 },
                  "at_word": { "type": "string" },
                  "shot": { "$ref": "#/$defs/shot" },
                  "target": { "type": "string" },
                  "move": { "$ref": "#/$defs/move" },
                  "angle": { "$ref": "#/$defs/angle" },
                  "blend": { "type": "number", "minimum": 0, "maximum": 3, "description": "0 = hard cut, >0 = smooth camera transition in seconds" }
                }
              }
            },
            "shake": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["time", "duration", "intensity"],
                "properties": {
                  "time": { "type": "number", "minimum": 0 },
                  "at_word": { "type": "string" },
                  "duration": { "type": "number", "minimum": 0.05, "maximum": 5 },
                  "intensity": { "type": "number", "minimum": 0.05, "maximum": 3 }
                }
              }
            }
          }
        },
        "lighting": { "type": "string", "enum": ["day", "sunset", "night", "indoor_warm", "indoor_cool", "dramatic"] },
        "sound_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["cue", "time"],
            "properties": {
              "cue": { "type": "string", "description": "Cue name from config/sfx.json" },
              "time": { "type": "number", "minimum": 0 },
              "at_word": { "type": "string" },
              "volume": { "type": "number", "minimum": 0, "maximum": 2 }
            }
          }
        },
        "transition": { "type": "string", "enum": ["cut", "fade", "flash", "whip", "zoom"], "description": "Transition from this scene into the next" }
      }
    }
  }
}
