{
  "title": "Koin Emas di Pasar",
  "width": 720,
  "height": 1280,
  "fps": 30,
  "cast": {
    "budi": { "color": "#3b6fb6", "hat": "cap" },
    "raja": { "color": "#8e2c48", "hat": "crown" },
